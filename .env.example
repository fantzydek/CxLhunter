# ==============================================================
# CxL Bug Bounty Scanner - contoh konfigurasi
# Salin file ini menjadi .env lalu isi nilai yang diperlukan.
#   cp .env.example .env
# JANGAN commit file .env. JANGAN bagikan BOT_TOKEN ke siapa pun.
# ==============================================================

# ==== Telegram (WAJIB untuk mode bot) ====
# Token bot dari @BotFather
BOT_TOKEN=
# Telegram user ID admin (angka, dipisah koma). Admin boleh mengelola installer
# dan menghentikan scan pengguna lain. Dapatkan ID via @userinfobot.
ADMIN_IDS=
# (Opsional) Jika diisi, HANYA ID berikut yang boleh memakai bot (admin selalu diizinkan).
# PENTING: isi ID pengguna yang diizinkan. Kosong = siapa pun dapat mencoba memakai bot
# (tetap dibatasi scope, tetapi tetap tidak disarankan untuk bot publik).
ALLOWED_USERS=

# ==== Scope (OPSIONAL - boleh dibiarkan kosong) ====
# Kosong  = MODE TERBUKA: scanner menerima domain publik apa pun yang Anda kirim.
# Diisi   = scanner TERKUNCI hanya ke root domain berikut (beserta subdomennya).
# Isi jika bot dipakai beberapa orang atau Anda ingin pengaman ekstra, contoh:
#   ALLOWED_TARGETS=example.com,example.org
# Catatan: hanya scan domain yang Anda MILIKI atau punya IZIN RESMI untuk diuji.
ALLOWED_TARGETS=
# Port dan protokol yang diizinkan untuk pengujian.
ALLOWED_PORTS=80,443,8080,8443
ALLOWED_PROTOCOLS=https,http

# ==== Mode laboratorium lokal (default MATI) ====
# Hanya untuk target lab milik sendiri (mis. 127.0.0.1, 192.168.x.x di VM uji).
# LAB_ALLOWED_TARGETS boleh berupa host atau CIDR. Jangan pernah isi host produksi di sini.
LAB_MODE=false
LAB_ALLOWED_TARGETS=

# ==== Database ====
# auto = coba better-sqlite3 lalu node:sqlite (bawaan Node >= 22.5)
DB_DRIVER=auto
DB_PATH=data/cxl.db

# ==== Batas antrean & konkurensi ====
MAX_CONCURRENT_SCANS=1
QUEUE_MAX=5
MAX_SCANS_PER_USER=1

# ==== Batas per tahap scan ====
MAX_SUBDOMAINS=200
MAX_RESOLVE_TARGETS=200
MAX_LIVE_HOSTS=50
MAX_ENDPOINTS=300

# ==== Timeout engine (ms) ====
ENGINE_TIMEOUT_SUBFINDER_MS=120000
ENGINE_TIMEOUT_DNSX_MS=120000
ENGINE_TIMEOUT_HTTPX_MS=180000
ENGINE_TIMEOUT_KATANA_MS=300000
ENGINE_TIMEOUT_NUCLEI_MS=1200000
ENGINE_TIMEOUT_XRAY_MS=600000
ENGINE_TIMEOUT_HEADERPROBE_MS=180000
# Batas ukuran stdout/stderr per proses (byte)
MAX_OUTPUT_BYTES=33554432

# ==== Tuning engine (nilai konservatif untuk perangkat mobile) ====
HTTPX_THREADS=10
HTTPX_RATE_LIMIT=50
KATANA_DEPTH=3
KATANA_CONCURRENCY=5
KATANA_RATE_LIMIT=20
NUCLEI_CONCURRENCY=10
NUCLEI_RATE_LIMIT=50
# Severity template Nuclei yang dijalankan: info,low,medium,high,critical
NUCLEI_SEVERITY=low,medium,high,critical
# Tag template yang SELALU dikecualikan (keamanan default). Jangan dikosongkan tanpa alasan kuat.
NUCLEI_EXCLUDE_TAGS=intrusive,destructive,bruteforce,dos,fuzz,stealth
# Interactsh (OOB) mengirim data ke server publik projectdiscovery. Default mati.
NUCLEI_ENABLE_OOB=false
# Update template hanya bila bernilai true (butuh persetujuan Anda; mengunduh dari sumber resmi).
NUCLEI_UPDATE_TEMPLATES=false
# Pemeriksaan file konfigurasi yang terekspos (/.env, /.git/HEAD, dll) - GET terbatas.
EXPOSED_FILES_CHECK=true

# ==== Path engine (opsional; kosongkan untuk pencarian PATH + ./bin) ====
NUCLEI_PATH=
SUBFINDER_PATH=
DNSX_PATH=
HTTPX_PATH=
KATANA_PATH=
XRAY_PATH=

# ==== Lainnya ====
USER_AGENT=CxLScanner/1.0 (authorized security assessment)
LOG_LEVEL=info

# ==== Engine internal (Node murni, tanpa binary eksternal) ====
# Bila binary eksternal (nuclei/subfinder/dll) tidak terpasang, engine internal
# dipakai OTOMATIS agar scan tetap berjalan. Set false untuk mematikan fallback.
INTERNAL_FALLBACK=true
# Batas konkurensi request engine internal (rendah = lebih sopan ke target)
INTERNAL_CONCURRENCY=4
# Jeda minimal antar request engine internal (ms)
INTERNAL_MIN_DELAY_MS=120
# Maksimum file JS yang dipindai untuk deteksi secrets
MAX_SECRETS_JS_FILES=30
# Maksimum URL (host hidup + endpoint hasil crawl) yang diperiksa engine vulnscan
MAX_VULN_SCAN_URLS=25
